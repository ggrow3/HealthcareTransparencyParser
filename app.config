<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <configSections>
    <section name="environmentSettings" type="System.Configuration.NameValueSectionHandler" />
  </configSections>

  <!-- Common settings used across all environments -->
  <appSettings>
    <add key="DefaultSchema" value="providers-reference;allowed-amounts;in-network-rates" />
    <add key="DefaultBatchSize" value="1000" />
    <add key="Environment" value="Development" />
    <!-- Development, Testing, Production -->
    <add key="LogLevel" value="Information" />
    <add key="EnableDetailedErrors" value="true" />
    <add key="HttpTimeoutMinutes" value="120" />
    <add key="EnableAutomaticRetry" value="true" />
    <add key="MaxRetryAttempts" value="3" />
      <!-- Table loading control -->
  <add key="LoadProvidersTable" value="true" />
  <add key="LoadAllowedAmountsTable" value="true" />
  <add key="LoadInNetworkRatesTable" value="true" />
  </appSettings>

  <!-- Environment-specific settings -->
  <environmentSettings>
    <!-- Development environment settings -->
    <add key="Development.ConnectionString" value="Server=tcp:healthcaretransparencyparser.database.windows.net,1433;Initial Catalog=HealthcareTransparencyParser;Persist Security Info=False;User ID=HealthcareTransparencyParserAdmin;Password=Test.123??!;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;" />
    <add key="Development.MockDataEnabled" value="true" />
    <add key="Development.MockProvidersCount" value="500" />
    <add key="Development.ProcessingBatchSize" value="50" />
    <add key="Development.DataFileUrl" value="" />

    <!-- Testing environment settings -->
    <add key="Testing.ConnectionString" value="Server=test-server.example.com;Database=HealthcareTransparency;User Id=testuser;Password=TestPassword123!;TrustServerCertificate=True;" />
    <add key="Testing.MockDataEnabled" value="true" />
    <add key="Testing.MockProvidersCount" value="10000" />
    <add key="Testing.ProcessingBatchSize" value="500" />
    <add key="Testing.DataFileUrl" value="https://test-data.example.com/healthcare-data/providers-reference.json.gz" />

    <!-- Production environment settings -->
    <add key="Production.ConnectionString" value="Server=prod-server.example.com;Database=HealthcareTransparency;User Id=produser;Password=ProdPassword123!;TrustServerCertificate=True;" />
    <add key="Production.MockDataEnabled" value="false" />
    <add key="Production.MockProvidersCount" value="0" />
    <add key="Production.ProcessingBatchSize" value="1000" />
    <add key="Production.DataFileUrl" value="https://data.cms.gov/healthcare-data/providers-reference.json.gz" />
  
   <!-- Development environment -->
    <add key="Development.LoadProvidersTable" value="true" />
    <add key="Development.LoadAllowedAmountsTable" value="true" />
    <add key="Development.LoadInNetworkRatesTable" value="true" />
    <add key="Development.MockDataSeed" value="42" /> <!-- Random seed for reproducible data -->
  
    <!-- Testing environment -->
    <add key="Testing.LoadProvidersTable" value="true" />
    <add key="Testing.LoadAllowedAmountsTable" value="false" /> <!-- Disable this table in Testing -->
    <add key="Testing.LoadInNetworkRatesTable" value="true" />
    <add key="Testing.MockDataSeed" value="123" />
  
    <!-- Production environment -->
    <add key="Production.LoadProvidersTable" value="true" />
    <add key="Production.LoadAllowedAmountsTable" value="true" />
    <add key="Production.LoadInNetworkRatesTable" value="true" />
  
  </environmentSettings>
</configuration>